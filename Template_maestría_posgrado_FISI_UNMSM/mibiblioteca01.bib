	file = {PDF:C\:\\Users\\EVER\\Zotero\\storage\\SDPNXZRH\\Hütten et al. - 2024 - Deep Learning for Automated Visual Inspection in Manufacturing and Maintenance A Survey of Open- Ac.pdf:application/pdf},
