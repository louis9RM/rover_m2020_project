	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Machine Learning, Electrical Engineering and Systems Science - Image and Video Processing},
	file = {PDF:C\:\\Users\\EVER\\Zotero\\storage\\NKCYGFFP\\Hurtik et al. - 2020 - Poly-YOLO higher speed, more precise detection and instance segmentation for YOLOv3.pdf:application/pdf},
}

@inproceedings{puck_performance_2021,
