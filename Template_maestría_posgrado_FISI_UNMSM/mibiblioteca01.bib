	file = {PDF:C\:\\Users\\EVER\\Zotero\\storage\\JNZ55Z5S\\Niswar et al. - 2024 - Performance evaluation of microservices communication with REST, GraphQL, and gRPC.pdf:application/pdf},
}

@article{ig_comparative_2023,
	title = {Comparative analysis of the rest and grpc used in the monitoring system of communication network virtualized infrastructure},
