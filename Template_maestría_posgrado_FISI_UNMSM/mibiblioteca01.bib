	pages = {106576},
	file = {PDF:C\:\\Users\\EVER\\Zotero\\storage\\QKGUWUIT\\Prasanna et al. - 2025 - Moisture- responsive controlled-release herbicide system using guar gum and nano cellulose for susta.pdf:application/pdf},
}

@inproceedings{praveenraj_computer_2024,
