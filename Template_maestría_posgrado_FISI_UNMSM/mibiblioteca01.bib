	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Robotics},
	pages = {475--482},
	file = {PDF:C\:\\Users\\EVER\\Zotero\\storage\\KWSZ68JR\\Lajoie y Beltrame - 2024 - Swarm-SLAM  Sparse Decentralized Collaborative Simultaneous Localization and Mapping Framework for.pdf:application/pdf},
