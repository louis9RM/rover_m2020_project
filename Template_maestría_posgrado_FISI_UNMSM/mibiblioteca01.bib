
@article{yanyachi_laser_robmap_2025,
	title = {Laser\_RobMap: {An} open source {ROS2} compatible tool for {3D} mapping using a {Mobile} {Robot} and {2D} {LiDAR}},
	volume = {30},
	issn = {23527110},
	shorttitle = {Laser\_RobMap},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2352711025001098},
	doi = {10.1016/j.softx.2025.102142},
	abstract = {We propose a tool for implementing a low-cost 3D mapping system using a vertically mounted 2D LiDAR sensor on a mobile robot, compatible with ROS2. The tool adapts to any ROS2-enabled robot that provides inertial and odometry data, with configurable parameters to optimize performance on systems with limited computational resources. Its main objective is to deliver a cost-effective 3D mapping solution for autonomous navigation using 3D SLAM. The results can be exported as 3D point clouds in PCD, LAS, and PLY formats, with an optional voxelization feature for efficient data management.},
